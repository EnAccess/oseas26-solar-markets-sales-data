# --- Server ---
BACKEND_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Mode ---
# false -> real datasets from data/raw/<COUNTRY_CODE>/ (default)
# true  -> fully synthetic DEMO DATA for pipeline testing only
DEMO_MODE=false
DEFAULT_COUNTRY=RW

# --- Spatial grid ---
GRID_RESOLUTION_KM=5

# --- Model ---
FEATURES=population_density,nighttime_radiance,relative_wealth,solar_resource,distance_to_grid_km,distance_to_minigrid_km,grid_presence,minigrid_presence,settlement_density
CV_FOLDS=5
SPATIAL_BLOCK_KM=30
SPATIAL_BUFFER_KM=10
RANDOM_SEED=42

# --- Market gap indicator ---
UNDERSERVED_THRESHOLD=0.55
NEED_W_POPULATION=0.4
NEED_W_GRID_DISTANCE=0.4
NEED_W_DARKNESS=0.2

# --- External API keys (only if you add downloaders; never commit real keys) ---
# NASA_EARTHDATA_TOKEN=

# --- AI assistant (optional) ---
# Leave empty to run without the assistant; evidence lookups still work.
ANTHROPIC_API_KEY=
ASSISTANT_MODEL=claude-opus-5-5
ASSISTANT_TIMEOUT_S=60
